+}
+
+/* Nearest (N, m) to the requested offset. N: multiples of the hardware loop
+ * alignment up to max_samples; m: whole turns, |m| < N/2 (below Nyquist).
+ * Ties prefer the shorter loop. */
+static void plan_tone(double fs_hz, double offset_hz, unsigned *n_out, int *m_out, double *actual_hz)
+{
+    const iq_tx_caps_t *caps = iq_tx_capabilities();
+    unsigned align = (unsigned)caps->loop_alignment_samples;
+    unsigned max_n = (unsigned)caps->max_samples;
+    double best_err = 1e30;
+    unsigned best_n = align;
+    int best_m = 0;
+    for (unsigned n = align; n <= max_n; n += align) {
+        long m = lround(offset_hz * (double)n / fs_hz);
+        long lim = (long)(n / 2) - 1;
+        if (m > lim) {
+            m = lim;
+        }
+        if (m < -lim) {
+            m = -lim;
+        }
+        double err = fabs(fs_hz * (double)m / (double)n - offset_hz);
+        if (err < best_err) {
+            best_err = err;
+            best_n = n;
+            best_m = (int)m;
+            if (err < 1.0) {
+                break;
+            }
+        }
+    }
+    *n_out = best_n;
+    *m_out = best_m;
+    *actual_hz = fs_hz * (double)best_m / (double)best_n;
+}
+
+static void fill_tone(unsigned n, int m)
+{
+    for (unsigned k = 0; k < n; ++k) {
+        long r = ((long)m * (long)k) % (long)n;
+        if (r < 0) {
+            r += (long)n;
+        }
+        float phase = 2.0f * 3.14159265358979323846f * (float)r / (float)n;
+        tone[k] = iq_tx_pack((int16_t)lroundf(AMPLITUDE * cosf(phase)),
+                             (int16_t)lroundf(AMPLITUDE * sinf(phase)));
+    }
+}
+
+static int fail_msg(int ret)
+{
+    lock();
+    ui_draw();
+    unlock();
+    return ret;
+}
 
