+/* ---- T-Deck keyboard (I2C 0x55, one ASCII byte per read, 0 = none) ---- */
+
+static i2c_master_dev_handle_t g_kbd;
+
+static esp_err_t keyboard_init(void)
+{
+    i2c_master_bus_config_t bus_cfg = {
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .i2c_port = I2C_NUM_0,
+        .sda_io_num = KBD_SDA,
+        .scl_io_num = KBD_SCL,
+        .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,
+    };
+    i2c_master_bus_handle_t bus;
+    esp_err_t err = i2c_new_master_bus(&bus_cfg, &bus);
+    if (err != ESP_OK) {
+        return err;
+    }
+    i2c_device_config_t dev_cfg = {
+        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+        .device_address = KBD_ADDR,
+        .scl_speed_hz = 400000,
+    };
+    return i2c_master_bus_add_device(bus, &dev_cfg, &g_kbd);
+}
+
+static void run_input_line(void)
+{
+    g_input[g_input_len] = '\0';
+    if (g_input_len == 0) {
+        return;
+    }
+    char cmd[INPUT_MAX + 1];
+    memcpy(cmd, g_input, g_input_len + 1);
+    g_input_len = 0;
+    g_input[0] = '\0';
+    set_msg("> %s", cmd);
+    int ret = 0;
+    esp_err_t err = esp_console_run(cmd, &ret);
+    if (err == ESP_ERR_NOT_FOUND) {
+        set_msg("unknown: %s", cmd);
+    } else if (err == ESP_ERR_INVALID_ARG) {
+        set_msg("empty command");
+    }
+    lock();
+    ui_draw();
+    unlock();
+}
+
+static void keyboard_task(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        uint8_t key = 0;
+        if (i2c_master_receive(g_kbd, &key, 1, 10) == ESP_OK && key != 0) {
+            if (key == '\r' || key == '\n') {
+                run_input_line();
+            } else if (key == 0x08 || key == 0x7f) {
+                if (g_input_len) {
+                    g_input[--g_input_len] = '\0';
+                    draw_input();
+                }
+            } else if (key >= 32 && key < 127 && g_input_len < INPUT_MAX) {
+                g_input[g_input_len++] = (char)key;
+                g_input[g_input_len] = '\0';
+                draw_input();
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
